{
  "name": "n8n-nodes-teamupcalendar",
  "version": "1.0.0",
  "description": "n8n nodes for the Teamup Calendar API: events, subcalendars, signups, comments, reminders, access keys and a trigger for event changes",
  "license": "MIT",
  "homepage": "https://github.com/Gr33ndev/n8n-nodes-teamupcalendar#readme",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Gilian Rehm",
    "email": "gilian.rehm@icloud.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gr33ndev/n8n-nodes-teamupcalendar.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test:integration": "npm run build && node test/integration.js"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TeamupApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Teamup/Teamup.node.js",
      "dist/nodes/Teamup/TeamupTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.56.1",
    "eslint": "9.39.4",
    "n8n-workflow": "1.117.0",
    "prettier": "3.8.3",
    "release-it": "^19.0.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
